<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.interview</groupId>
    <artifactId>portfolio-mgmt</artifactId>
    <version>1.0.0</version>
    <name>portfolio-mgmt</name>
    <description>
        Financial Portfolio &amp; Order Management System - Interview Preparation Reference Project.
        Demonstrates advanced Hibernate 6 / Spring Data JPA concepts: inheritance mapping, N+1 solutions,
        optimistic/pessimistic locking, L2 caching, transaction propagation, and Criteria/Specification queries.
    </description>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <hibernate.version>6.5.2.Final</hibernate.version>
        <hibernate-jcache.version>6.5.2.Final</hibernate-jcache.version>
        <caffeine-jcache.version>2.10.0</caffeine-jcache.version>
    </properties>

    <dependencies>
        <!-- Core Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Database drivers: H2 for local/interview-demo runs, Postgres for "production" profile -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Hibernate L2 Cache: JCache (JSR-107) provider bridge + Caffeine as the cache implementation -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-jcache</artifactId>
            <version>${hibernate-jcache.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine-jcache</artifactId>
            <version>${caffeine-jcache.version}</version>
        </dependency>

        <!-- Lombok - reduces boilerplate on entities/DTOs, common in enterprise codebases -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct-free manual mapping is used here intentionally to keep entity<->DTO conversion
             explicit and visible for interview discussion, so no mapper dependency is included. -->

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- Note: H2 is already declared above with scope=runtime, which is sufficient for both
         the running application and the test classpath (runtime scope is included in test
         classpath by Maven's dependency scope rules), so it is intentionally not re-declared
         here with scope=test. -->
    

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
